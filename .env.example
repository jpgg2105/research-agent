# --- LLM provider: openai | anthropic | fake ---
# Use "fake" for a zero-key offline smoke test of the full pipeline.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint, e.g. Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Retrieval: rag | web | local | stub ---
# stub  = offline, no services (default)
# rag   = call your running ai-document-analyst service
# web   = your own web-search implementation (see tools/web_search.py)
RETRIEVAL_MODE=stub
# local = BM25 over a JSONL corpus of {id, title, text}
LOCAL_CORPUS_PATH=
RAG_BASE_URL=http://localhost:8000
RAG_QUERY_PATH=/api/v1/query
TOP_K=5

# --- Orchestration ---
MAX_ITERATIONS=2
MAX_SUB_QUESTIONS=5
REQUEST_TIMEOUT_S=60
